# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Postgres ----
DB_USER=studenthub
DB_PASSWORD=your_db_password
DB_NAME=studenthub
DB_HOST=localhost
DB_PORT=5432
# Set to "true" when connecting to a managed Postgres over the public internet
# (Render external DB, Neon, Supabase...). Keep "false" inside the provider network.
DB_SSL=false
# Optional: cap on pooled connections (default 10)
DB_POOL_MAX=10

# ---- Auth ----
# Use a long random string in production: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret

# ---- Cloudinary (attachments) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- CORS ----
# Comma separated list of allowed frontends.
# Use * to allow any origin (development only).
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
